# Configuração SFTP
SFTP_HOST=hostname-do-seu-servidor.com
SFTP_PORT=22
SFTP_USERNAME=seu-usuario-sftp
SFTP_PASSWORD=sua-senha-sftp
SFTP_REMOTE_DIR=/caminho/para/logs/deadside

